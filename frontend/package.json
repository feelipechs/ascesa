{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.development -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:dev:up": "podman-compose -f compose.dev.yml up -d",
    "db:dev:stop": "podman-compose -f compose.dev.yml stop",
    "db:dev:down": "podman-compose -f compose.dev.yml down -v",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "dotenv -e .env.development -- tsx prisma/seed.ts",
    "db:seed:dev": "dotenv -e .env.development -- tsx prisma/seed-dev.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:prod:deploy": "NODE_ENV=production prisma migrate deploy"
