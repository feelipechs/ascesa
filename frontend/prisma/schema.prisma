generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [unaccent]
}

// ------------------------------
// CONFIGURACAO DO SITE (singleton)
// ------------------------------
model SiteSettings {
  id              String   @id @default("main")
  email           String?
  phone           String?
  address         String?
  cnpj            String?
  about           String?
  mission         String?
  vision          String?
  values          String?
  socialInstagram String?
  socialFacebook  String?
  socialYoutube   String?
  socialWhatsapp  String?
  socialLinkedin       String?
  googleMapsEmbedUrl  String?
  createdAt           DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ------------------------------
// MEDIA (biblioteca centralizada de imagens)
// ------------------------------
model Media {
  id String @id @default(nanoid())
  key String @unique
  hash String
  url String
  mimeType String
  size Int
  originalName String?
  width Int?
  height Int?
  alt String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  areaCovers Area[]
  projectCovers Project[]
  postCovers Post[]
  animalCovers Animal[]
  teamMemberPhotos TeamMember[]
  partnerLogos Partner[]
  galleryImages GalleryImage[]
}

// ------------------------------
// AREA DE ATUACAO
// ------------------------------
model Area {
  id String @id @default(nanoid())
  title String
  slug String @unique
  description String?
  coverMediaId String?
  coverMedia Media? @relation(fields: [coverMediaId], references: [id])
  iconName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects Project[]
  members TeamMemberArea[]
}

// ------------------------------
// PROJETO / EVENTO (agora só EVENTO)
// ------------------------------
model Project {
  id String @id @default(nanoid())
  title String
  slug String @unique
  description String?
  content String?
  coverMediaId String?
  coverMedia Media? @relation(fields: [coverMediaId], references: [id])
  eventDate DateTime?
  location String?
  vacancies Int?
  metrics Json?
  featured Boolean @default(false)
  areaId String
  area Area @relation(fields: [areaId], references: [id])
  gallery GalleryImage[]
  registrations Registration[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------
// GALERIA DE IMAGENS
// ------------------------------
enum GalleryContext {
  HOME
  PROJECT
  ANIMAL
}

model GalleryImage {
  id String @id @default(nanoid())
  mediaId String
  media Media @relation(fields: [mediaId], references: [id])
  caption String?
  order Int @default(0)
  context GalleryContext @default(PROJECT)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  animalId String?
  animal Animal? @relation(fields: [animalId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------
// MEMBRO DA EQUIPE
// ------------------------------
model TeamMember {
  id String @id @default(nanoid())
  name String
  role String
  bio String?
  photoMediaId String?
  photoMedia Media? @relation(fields: [photoMediaId], references: [id])
  order Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  areas TeamMemberArea[]
}

model TeamMemberArea {
  teamMemberId String
  areaId       String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  area         Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([teamMemberId, areaId])
}

// ------------------------------
// PARCEIRO / APOIADOR
// ------------------------------
model Partner {
  id String @id @default(nanoid())
  name String
  logoMediaId String
  logoMedia Media @relation(fields: [logoMediaId], references: [id])
  websiteUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------
// CATEGORIA DE DOCUMENTO
// ------------------------------
model DocumentCategory {
  id        String     @id @default(nanoid())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]
}

// ------------------------------
// DOCUMENTO
// ------------------------------
model Document {
  id          String           @id @default(nanoid())
  title       String
  description String?
  fileUrl     String
  year        Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  categoryId  String
  category    DocumentCategory @relation(fields: [categoryId], references: [id])
}

// ------------------------------
// USUARIO ADMIN
// ------------------------------
enum Role {
  ADMIN
  STAFF
}

model User {
  id           String    @id @default(nanoid())
  email        String    @unique
  emailVerified Boolean   @default(false)
  name         String?
  image        String?
  role         Role      @default(STAFF)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  accounts     Account[]
}

model Session {
  id        String   @id @default(nanoid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(nanoid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(nanoid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ------------------------------
// DEPOIMENTO (standalone)
// ------------------------------
model Testimonial {
  id          String    @id @default(nanoid())
  name        String
  role        String?
  message     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ------------------------------
// VOLUNTARIO
// ------------------------------
model Volunteer {
  id            String         @id @default(nanoid())
  name          String
  email         String         @unique
  phone         String?
  birthDate     DateTime?
  registrations Registration[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ------------------------------
// INSCRICAO EM EVENTO
// ------------------------------
enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Registration {
  id           String             @id @default(nanoid())
  status       RegistrationStatus @default(PENDING)
  message      String?
  volunteerId  String
  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([volunteerId, projectId])
  @@index([projectId])
}

// ------------------------------
// POST (Blog)
// ------------------------------
model Post {
  id String @id @default(nanoid())
  title String
  slug String @unique
  excerpt String?
  content String?
  coverMediaId String?
  coverMedia Media? @relation(fields: [coverMediaId], references: [id])
  author String?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------
// STAT (Home — seção de métricas)
// ------------------------------
model Stat {
  id          String   @id @default(nanoid())
  label       String
  value       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------
// ANIMAL
// ------------------------------
enum AnimalGender {
  MALE
  FEMALE
}

enum AnimalStatus {
  AVAILABLE
  ADOPTED
  FOSTERED
}

enum AnimalSpecies {
  DOG
  CAT
  BIRD
  RABBIT
  HAMSTER
  FISH
  OTHER
}

enum AnimalSize {
  SMALL
  MEDIUM
  LARGE
}

enum AnimalAgeRange {
  PUPPY
  ADULT
  SENIOR
}

model Animal {
  id String @id @default(nanoid())
  name String
  slug String @unique
  species AnimalSpecies
  breed String?
  gender AnimalGender
  size AnimalSize?
  birthDate DateTime?
  ageRange AnimalAgeRange?
  shelterSince DateTime @default(now())
  description String?
  content String?
  coverMediaId String?
  coverMedia Media? @relation(fields: [coverMediaId], references: [id])
  status AnimalStatus @default(AVAILABLE)
  featured Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gallery GalleryImage[]
}

// ------------------------------
// METODO DE PAGAMENTO
// ------------------------------
enum PaymentMethodType {
  PIX
  BANK_TRANSFER
  CASH
}

model PaymentMethod {
  id           String            @id @default(nanoid())
  type         PaymentMethodType
  label        String
  instructions String?
  isActive     Boolean           @default(true)
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  pixConfig    PixConfig?
  bankConfig   BankConfig?
}

model PixConfig {
  id            String        @id
  paymentMethod PaymentMethod @relation(fields: [id], references: [id], onDelete: Cascade)
  key           String
  receiverName  String
  receiverCity  String
}

model BankConfig {
  id            String        @id
  paymentMethod PaymentMethod @relation(fields: [id], references: [id], onDelete: Cascade)
  bankName      String
  agency        String
  account       String
  accountType   String?
}

// ------------------------------
// NOTA FISCAL
// ------------------------------
enum FiscalNoteType {
  DETAILED
  ACCESS_KEY
}

model FiscalNote {
  id         String         @id @default(nanoid())
  type       FiscalNoteType
  cnpj       String?
  emissionDate DateTime?
  coo        String?
  amount     Decimal?       @db.Decimal(10, 2)
  accessKey  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}
