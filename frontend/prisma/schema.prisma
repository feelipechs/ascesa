generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [unaccent]
}

// ------------------------------
// CONFIGURACAO DO SITE (singleton)
// ------------------------------
model SiteSettings {
  id              String   @id @default("main")
  email           String?
  phone           String?
  address         String?
  cnpj            String?
  about           String?
  mission         String?
  vision          String?
  values          String?
  homeTitle       String?
  homeSubtitle    String?
  socialInstagram String?
  socialFacebook  String?
  socialYoutube   String?
  socialWhatsapp  String?
  socialLinkedin  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ------------------------------
// AREA DE ATUACAO
// ------------------------------
model Area {
  id          String           @id @default(nanoid())
  title       String
  slug        String           @unique
  description String?
  coverUrl    String?
  iconName    String?
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  projects    Project[]
  members     TeamMemberArea[]
}

// ------------------------------
// PROJETO / EVENTO (unificado por contexto)
// ------------------------------
enum ProjectContext {
  CAMPAIGN
  EVENT
}

model Project {
  id             String         @id @default(nanoid())
  title          String
  slug           String         @unique
  description    String?
  content        String?
  coverUrl       String?
  context        ProjectContext @default(CAMPAIGN)
  eventDate      DateTime?      // EVENT apenas
  location       String?        // EVENT apenas
  vacancies      Int?           // EVENT apenas — admin define limite
  metrics        Json?          // Array [{ label, value }] validado por Zod
  featured       Boolean        @default(false)
  publishedAt    DateTime?
  areaId         String
  area           Area           @relation(fields: [areaId], references: [id])
  gallery        GalleryImage[]
  testimonials   Testimonial[]
  registrations  Registration[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// ------------------------------
// GALERIA DE IMAGENS
// ------------------------------
enum GalleryContext {
  HOME
  PROJECT
}

model GalleryImage {
  id        String         @id @default(nanoid())
  url       String
  caption   String?
  order     Int            @default(0)
  context   GalleryContext @default(PROJECT)
  projectId String?
  project   Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

// ------------------------------
// MEMBRO DA EQUIPE
// ------------------------------
model TeamMember {
  id          String           @id @default(nanoid())
  name        String
  role        String
  bio         String?
  photoUrl    String?
  order       Int              @default(0)
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  areas       TeamMemberArea[]
}

model TeamMemberArea {
  teamMemberId String
  areaId       String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  area         Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([teamMemberId, areaId])
}

// ------------------------------
// PARCEIRO / APOIADOR
// ------------------------------
model Partner {
  id          String    @id @default(nanoid())
  name        String
  logoUrl     String
  websiteUrl  String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ------------------------------
// CATEGORIA DE DOCUMENTO
// ------------------------------
model DocumentCategory {
  id        String     @id @default(nanoid())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]
}

// ------------------------------
// DOCUMENTO
// ------------------------------
model Document {
  id          String           @id @default(nanoid())
  title       String
  description String?
  fileUrl     String
  year        Int?
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  categoryId  String
  category    DocumentCategory @relation(fields: [categoryId], references: [id])
}

// ------------------------------
// USUARIO ADMIN
// ------------------------------
enum Role {
  ADMIN
  STAFF
}

model User {
  id        String   @id @default(nanoid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------
// DEPOIMENTO
// ------------------------------
model Testimonial {
  id        String   @id @default(nanoid())
  name      String
  role      String?
  message   String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------
// VOLUNTARIO (antiga Person)
// ------------------------------
model Volunteer {
  id            String         @id @default(nanoid())
  name          String
  email         String         @unique
  phone         String?
  birthDate     DateTime?
  registrations Registration[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ------------------------------
// INSCRICAO EM EVENTO (antiga Participation)
// ------------------------------
enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Registration {
  id           String             @id @default(nanoid())
  status       RegistrationStatus @default(PENDING)
  message      String?
  volunteerId  String
  volunteer    Volunteer          @relation(fields: [volunteerId], references: [id], onDelete: Restrict)
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([volunteerId, projectId])
}

// ------------------------------
// POST (Blog)
// ------------------------------
model Post {
  id          String   @id @default(nanoid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String?
  coverUrl    String?
  author      String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------
// STAT (Home — seção de métricas)
// ------------------------------
model Stat {
  id          String   @id @default(nanoid())
  label       String
  value       String
  order       Int      @default(0)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
